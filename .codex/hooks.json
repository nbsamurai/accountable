{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash|mcp__filesystem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/protect-env.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/check-quick.mjs\"",
            "timeout": 120,
            "statusMessage": "Running npm run check:quick"
          }
        ]
      }
    ]
  }
}
