{
  "name": "accountable",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/test.mjs check:static test",
    "check:quick": "node scripts/test.mjs check:static test:quick",
    "check:static": "node scripts/test.mjs format:check:frontend format:check:backend lint:frontend lint:backend typecheck:backend check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "node scripts/test.mjs format:frontend format:backend",
    "format:frontend": "npm run format --workspace frontend",
    "format:backend": "uv run ruff format backend",
    "format:check:frontend": "npm run format:check --workspace frontend",
    "format:check:backend": "uv run ruff format --check backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "lint:backend": "uv run ruff check backend",
    "typecheck:backend": "uv run ty check backend",
    "test": "node scripts/test.mjs test:frontend test:backend test:e2e",
    "test:quick": "node scripts/test.mjs test:frontend test:backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "uv run pytest --cov=backend/app --cov-report=term-missing --cov-fail-under=80",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "seed": "uv run python -m backend.app.seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1"
  }
}
